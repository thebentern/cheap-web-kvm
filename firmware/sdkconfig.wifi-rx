# SPDX-License-Identifier: GPL-3.0-or-later
# Opt-in receive-throughput experiment based on ESP-IDF's ESP32-S3 iperf profile.
# Virtual-media READ replies travel from the browser into the board.
# Keep RX BA <= min(2 * static RX, dynamic RX); leave TX and TCP settings alone.
# Versus 10/32 RX buffers, allow approximately 9.6 KB more static RAM and
# another 51.2 KB at peak RX occupancy. Measure heap and boot reliability.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32
