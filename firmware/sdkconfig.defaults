# SPDX-License-Identifier: GPL-3.0-or-later

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Host control and virtual media share UART0.
CONFIG_KVM_UART_BAUD=921600

# GPIO19/20 are muxed between USB-OTG and USB Serial/JTAG, and UART0 carries the
# host protocol, so the console goes to UART1. Set CONFIG_ESP_CONSOLE_NONE once
# it is no longer needed.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_1=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=17
CONFIG_ESP_CONSOLE_UART_RX_GPIO=18
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# The secondary console defaults to USB Serial/JTAG, which keeps the USJ pad
# alive on the same GPIO19/20 the OTG peripheral needs. Disabling the module
# outright also drops its startup clock; its built-in JTAG is unusable here
# anyway, since those pins belong to USB-OTG.
#
# Regenerate after changing these: sdkconfig.defaults does not override an
# existing firmware/sdkconfig. Delete it and rebuild.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# Boot keyboard + pointer.
CONFIG_TINYUSB_HID_COUNT=2

# 1 ms resolution for the inter-report floor in kvm_hid.c.
CONFIG_FREERTOS_HZ=1000

# Octal PSRAM left disabled: it consumes GPIO35/36/37 and nothing here needs it.

# Bluetooth LE transport (main/kvm_ble.c). NimBLE peripheral only: the board
# never scans or initiates, so the central and observer roles are dropped.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# Bonds survive a power cycle, so the host pairs once.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Secure Connections only: a legacy-pairing passkey can be recovered offline
# from a sniffed pairing exchange.
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y

# Composite keyboard (0), mouse (1), asynchronous client-backed MSC (2).
# MSC is enabled in kvm_tusb_config.h; do not link the vendor storage frontend.
CONFIG_TINYUSB_MSC_ENABLED=n
CONFIG_HTTPD_WS_SUPPORT=y

# Wi-Fi + BLE + MSC needs more than the 1 MiB default factory app slot.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
